# Backend
DATABASE_URL=

# AI generation remains off by default; set AI_PROVIDER=openai and AI_ENABLED=true to opt in.
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=32000
AI_MAX_OUTPUT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CHAT_MESSAGES=30
