# Backend: file-based H2 is embedded. No external RDB, DATABASE_URL, Docker or DB credentials required.
# Optional: override the local file path (relative to be/).
# LOCAL_DB_FILE=./data/hongik-graduate

# Development: put only AI_API_KEY in be/.env-local to auto-enable OpenAI.
# Leave the key empty to keep AI disabled; never commit actual keys.
# Uncomment to override automatic selection or explicitly switch AI off:
# AI_ENABLED=false
# AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=32000
AI_MAX_OUTPUT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CHAT_MESSAGES=30
